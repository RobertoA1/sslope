# Next.js local: puedes omitirlo para usar http://127.0.0.1:8001.
# En Vercel es obligatorio y debe apuntar al origen HTTPS del backend, sin /api.
CENTURY_API_ORIGIN=http://127.0.0.1:8001
# Configurar en el proceso FastAPI externo, no en Next.js. Orígenes exactos separados por comas.
# CENTURY_ALLOWED_ORIGINS=https://century.example.org,https://century-preview.example.org
# Carpeta persistente del backend; no corresponde al almacenamiento de Vercel.
# CENTURY_LAB_RUNTIME=/ruta/persistente/century-runtime
