# CENTURY_BACKEND_URL lo inyecta el binding de Vercel Services. No lo definas.
# Solo para ejecutar Next.js por separado fuera de Vercel; el valor predeterminado es localhost:8001.
# CENTURY_API_ORIGIN=http://127.0.0.1:8001
# Solo para exponer FastAPI por separado; el proxy Services comprueba el origen público.
# CENTURY_ALLOWED_ORIGINS=https://century.example.org
# Carpeta persistente para el entrenamiento local.
# CENTURY_LAB_RUNTIME=/ruta/persistente/century-runtime
