# Clave privada: solo se lee en el servidor. Nunca la subas a Git.
OPENAI_API_KEY=
# Cambia el modelo según los disponibles en tu cuenta de OpenAI.
OPENAI_MODEL=gpt-4o-mini
# Opcional para servidor local/Docker (Vercel usa almacenamiento temporal).
# SSLOPE_DB_PATH=/ruta/persistente/sslope.sqlite
# Hosts adicionales permitidos fuera de Vercel, separados por comas, sin protocolo ni puerto.
# SSLOPE_ALLOWED_HOSTS=taludes.example.org
